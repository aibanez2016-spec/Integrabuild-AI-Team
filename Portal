  }).join('');
  document.getElementById('skills').innerHTML = SKILLS.map((k) => '<span class="chip">' + k + '</span>').join('');
  document.getElementById('missing').innerHTML = tr().missing.map((x) => '<li>' + esc(x) + '</li>').join('');
  document.getElementById('axis').innerHTML = tr().axis.map((x) => '<span>' + x + '</span>').join('');
}
function drawSched() {
  const t = riyadh(), pct = (h) => ((h - 8) / 10 * 100), nowH = t.h + t.m / 60;
  document.getElementById('sched').innerHTML = [0, 1, 2, 3, 4, 5, 6].map((d) => {
    const work = d <= 4;
    let inner = work ? '<span class="shift" style="inset-inline-start:0;width:' + pct(17) + '%"></span><span class="mk" style="inset-inline-start:calc(' + pct(16 + 55 / 60) + '% - 1px)"></span>' : '';
    if (work) inner += '<span class="mk stand" style="inset-inline-start:calc(' + pct(17 + 7 / 60) + '% - 1px)"></span>';
    if (d === 0) inner += '<span class="mk meet" style="inset-inline-start:calc(' + pct(9 + 13 / 60) + '% - 1px)"></span>';
    if (d === 3) inner += '<span class="mk it" style="inset-inline-start:calc(' + pct(17 + 38 / 60) + '% - 1px)"></span>';
    if (d === 4) inner += '<span class="mk fin" style="inset-inline-start:calc(' + pct(17 + 12 / 60) + '% - 1px)"></span>';
    if (d === 4) inner += '<span class="mk mgr" style="inset-inline-start:calc(' + pct(17 + 26 / 60) + '% - 1px)"></span>';
    if (d === t.day && nowH >= 8 && nowH <= 18) inner += '<span class="nowline" style="inset-inline-start:' + pct(nowH) + '%"></span>';
    return '<div class="day"><b>' + tr().days[d] + (work ? '' : ' <span style="color:var(--muted);font-weight:400">' + tr().off + '</span>') + '</b><div class="track">' + inner + '</div></div>';
  }).join('');
  document.getElementById('n1').textContent = '→ ' + nextRun(t, [0, 1, 2, 3, 4], 16, 55);
  document.getElementById('n2').textContent = '→ ' + nextRun(t, [4], 17, 26);
  document.getElementById('n3').textContent = '→ ' + nextRun(t, [4], 17, 12);
  document.getElementById('n4').textContent = '→ ' + nextRun(t, [3], 17, 38);
  document.getElementById('n5').textContent = '→ ' + nextMonthly();
  document.getElementById('n6').textContent = '→ ' + nextRun(t, [0], 9, 13);
}
function tick() {
  const t = riyadh(), duty = onDuty(t);
  document.getElementById('clock').textContent = fmt12(t.h, t.m);
  document.getElementById('sdot').className = 'dot' + (duty ? ' on' : '');
  document.getElementById('stext').textContent = duty ? tr().onduty : (t.day >= 5 ? tr().weekend : tr().offduty);
}
function applyLang() {
  const root = document.documentElement;
  root.lang = L; root.dir = L === 'ar' ? 'rtl' : 'ltr';
  document.title = tr().title;
  document.querySelectorAll('[data-t]').forEach((el) => { const v = tr()[el.dataset.t]; if (typeof v === 'string') el.textContent = v; });
  document.getElementById('langbtn').textContent = tr().lang;
  drawScene(); drawCards(); drawSched(); tick(); pick(picked);
  document.getElementById('mgrpt').innerHTML = portrait('mgr');
  document.getElementById('chatin').placeholder = tr().chatEmpty;
  document.getElementById('quick').innerHTML = tr().quick.map((q) => '<button type="button" class="qbtn">' + esc(q) + '</button>').join('');
  if (briefState !== 'loading') document.getElementById('briefst').textContent = BRIEFS.length ? tr().briefOk.replace('{n}', BRIEFS.length).replace('{d}', BRIEFS[0].date || '') : tr().briefNone;
  renderChat();
  document.getElementById('po-rating').replaceChildren();
  document.getElementById('pc-cat').replaceChildren();
  renderPortal();
}
document.getElementById('langbtn').addEventListener('click', () => {
  L = L === 'ar' ? 'en' : 'ar';
  try { localStorage.setItem('ib-lang', L); } catch (e) {}
  applyLang();
});
document.querySelectorAll('.tab').forEach((b) => b.addEventListener('click', () => pick(b.dataset.id)));
document.getElementById('quick').addEventListener('click', (e) => { const b = e.target.closest('.qbtn'); if (b) ask(b.textContent); });
document.getElementById('chatform').addEventListener('submit', (e) => { e.preventDefault(); const i = document.getElementById('chatin'); const v = i.value; i.value = ''; ask(v); });
document.getElementById('chatclear').addEventListener('click', () => { if (chatAbort) chatAbort.abort(); CHAT = []; saveChat(); renderChat(); });
document.getElementById('po-tabs').addEventListener('click', (e) => { const b = e.target.closest('.po-tab'); if (b) { PO.tab = b.dataset.p; renderPortal(); } });
document.getElementById('po-rating').addEventListener('change', (e) => { PO.rating = e.target.value; renderPortal(); });
document.getElementById('po-cost').addEventListener('submit', (e) => {
  e.preventDefault();
  const item = document.getElementById('pc-item').value.trim(), amount = Number(document.getElementById('pc-amt').value);
  if (!item || !isFinite(amount) || amount < 0 || !PO.db) return;
  poWrite(async (db) => { await db.collection('data/team/costs').add({ date: document.getElementById('pc-date').value || rDay(0), item, category: document.getElementById('pc-cat').value, amount }); document.getElementById('pc-item').value = ''; document.getElementById('pc-amt').value = ''; });
});
applyLang();
loadBriefs();
startPortal();
let lastDuty = onDuty(riyadh());
const timer = setInterval(() => { const d = onDuty(riyadh()); tick(); drawSched(); if (d !== lastDuty) { lastDuty = d; drawScene(); } pick(picked); }, 30000);
}

</script>
</body>
