<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Integrabuild AI Team</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;700&display=swap" rel="stylesheet">
<style>
/* VOICE work: an operations floor the owner walks through
   IDEA an isometric architect's floor plan of the company HQ, in the brand's navy and gold
   PICTURE the office itself: three departments, desks, live screens, a status lamp per employee
   COLOUR navy #0e2240 band and floor, gold #c9a227 accent, white/deep-navy ground below
   TYPE IBM Plex Sans Arabic 700 for titles, 400 for text
   LAYOUT laptop: title row with clock and status, office full width, picked employee strip under it; phone: title, office, strip, then sections stacked */
:root{color-scheme:light dark;--bg:light-dark(#ffffff,#0a1628);--ink:light-dark(#0e1a2b,#e9eef6);--muted:light-dark(#566275,#9fb0c8);--line:light-dark(#dde3ec,#22344f);--panel:light-dark(#f4f6fa,#111f36);--navy:#0e2240;--gold:#c9a227;--ok:#3ccf8e;--off:#7d8aa0}
:root[data-theme=light]{color-scheme:light}
:root[data-theme=dark]{color-scheme:dark}
*{box-sizing:border-box;min-width:0}
html{scroll-padding-top:72px}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 "IBM Plex Sans Arabic",Tahoma,sans-serif;overflow-x:clip}
a{color:inherit}
.wrap{max-width:1240px;margin:0 auto}
.band{padding-block:clamp(28px,4vw,64px);padding-inline:max(5vw,16px)}
.nav{background:var(--navy);color:#fff;padding-inline:max(5vw,16px);border-bottom:1px solid #ffffff1a}
.nav .wrap{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 24px;min-height:60px}
.brand{font-weight:700;font-size:18px;letter-spacing:-.01em}
.brand b{color:var(--gold)}
.links{display:flex;flex-wrap:wrap;gap:4px 18px;font-size:15px}
.links a{text-decoration:none;opacity:.85;padding:10px 0}
.links a:hover,.links a:focus-visible{opacity:1;text-decoration:underline;text-underline-offset:6px}
.hero{background:var(--navy);color:#fff;padding-top:clamp(20px,3vw,36px);padding-bottom:0}
.hrow{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px 32px}
h1{font-size:clamp(32px,4.4vw,50px);line-height:1.05;letter-spacing:-.02em;margin:0;text-wrap:balance}
.sub{color:#c7d3e6;margin:10px 0 0;max-width:60ch}
.clock{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.time{font-size:30px;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}
.pill{display:inline-flex;align-items:center;gap:8px;border:1px solid #ffffff33;border-radius:999px;padding:6px 14px;font-size:15px;white-space:nowrap}
.dot{width:10px;height:10px;border-radius:50%;background:var(--off)}
.dot.on{background:var(--ok);box-shadow:0 0 0 4px #3ccf8e33}
.scene{margin-top:18px;position:relative}
.scene svg{display:block;width:100%;height:auto;max-height:760px}
.scroll-scene{overflow-x:auto}
@media(max-width:600px){.scene svg{width:760px;max-width:none;max-height:none}}
.desk{cursor:pointer;outline:none}
.desk:focus-visible .sel,.desk.picked .sel{opacity:1}
.sel{opacity:0;transition:opacity .2s}
.lbl{font:700 13px "IBM Plex Sans Arabic",sans-serif;fill:#fff;paint-order:stroke;stroke:#0e2240;stroke-width:5px}
.lbl2{font:500 12.5px "IBM Plex Sans Arabic",sans-serif;fill:#c9a227;paint-order:stroke;stroke:#0e2240;stroke-width:4px}
.ln{stroke:#1d3f73;stroke-width:2;stroke-linecap:round}
.ln.go{stroke-dasharray:60;stroke-dashoffset:60;animation:type 2.6s steps(14) infinite}
@keyframes type{to{stroke-dashoffset:0}}
@media (prefers-reduced-motion:reduce){.ln.go{animation:none;stroke-dashoffset:0}}
.strip{background:var(--panel);border-top:3px solid var(--gold)}
.strip .wrap{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr) minmax(0,1fr);gap:20px 32px;align-items:start}
.who{display:flex;gap:14px;align-items:center}
.av{flex:none;width:84px;height:92px}
.av svg,.pt svg{display:block;width:100%;height:auto}
.pt{margin:-8px -8px 4px;border-radius:14px;overflow:hidden;max-width:220px}
.who h2{margin:0;font-size:22px;line-height:1.2}
.who p{margin:2px 0 0;color:var(--muted);font-size:15px}
.k{font-size:13px;color:var(--muted);margin:0 0 4px}
.v{margin:0;font-weight:500}
.now{display:flex;gap:8px;align-items:center}
.tabs{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;grid-column:1/-1}
.tab{font:inherit;font-size:15px;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid var(--line);background:var(--bg);color:var(--ink);cursor:pointer}
.tab[aria-pressed=true]{background:var(--navy);color:#fff;border-color:var(--navy)}
.tab:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.note{font-size:13px;color:var(--muted);margin:14px 0 0;grid-column:1/-1}
h3{font-size:clamp(26px,3vw,34px);line-height:1.1;letter-spacing:-.02em;margin:0 0 6px}
.lead{color:var(--muted);margin:0 0 24px;max-width:65ch}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:22px;display:flex;flex-direction:column;gap:12px}
.card h4{margin:0;font-size:20px}
.card .role{color:var(--muted);margin:-8px 0 0;font-size:15px}
.card ul{margin:0;padding-inline-start:18px}
.card li{margin:2px 0}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{font-size:13px;border:1px solid var(--line);background:var(--bg);border-radius:999px;padding:3px 10px;direction:ltr}
.sched{display:grid;gap:10px}
.day{display:grid;grid-template-columns:5.5em minmax(0,1fr);gap:12px;align-items:center}
.day b{font-weight:500}
.track{position:relative;height:40px;background:var(--panel);border:1px solid var(--line);border-radius:8px}
.shift{position:absolute;top:6px;bottom:6px;background:color-mix(in srgb,var(--navy) 18%,transparent);border-radius:5px}
:root[data-theme=dark] .shift{background:#ffffff1c}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) .shift{background:#ffffff1c}}
.mk{position:absolute;top:2px;bottom:2px;width:3px;border-radius:2px;background:var(--gold)}
.mk.mgr{background:#e6261f}
.mk.fin{background:#2f7de1}
.mk.it{background:#12a594}
.mk.meet{background:#ff8a3d}
.mk.stand{background:#9b6bff}
.hcard.span2{grid-column:span 2}
@media(max-width:960px){.hcard.span2{grid-column:auto}}
.nowline{position:absolute;top:-4px;bottom:-4px;width:2px;background:var(--ink)}
.axis{display:grid;grid-template-columns:5.5em minmax(0,1fr);gap:12px;font-size:13px;color:var(--muted)}
.axis div{display:flex;justify-content:space-between}
.legend{display:flex;flex-wrap:wrap;gap:8px 20px;font-size:14px;color:var(--muted);margin-top:12px}
.legend i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-inline-end:6px;vertical-align:-1px}
.flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;counter-reset:s}
.step{border-top:3px solid var(--gold);padding-top:12px}
.step h4{margin:0 0 4px;font-size:18px}
.step p{margin:0;color:var(--muted);font-size:15px}
.cta{display:inline-flex;align-items:center;min-height:48px;padding:0 22px;border-radius:999px;background:var(--gold);color:#0e2240;font-weight:700;text-decoration:none;margin-top:24px}
.cta:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
footer{background:var(--navy);color:#c7d3e6}
footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px 40px}
footer b{color:#fff}
footer p{margin:4px 0}
.ltr{direction:ltr;unicode-bidi:isolate;white-space:nowrap}
@media(max-width:900px){.cards{grid-template-columns:minmax(0,1fr)}.flow{grid-template-columns:repeat(2,minmax(0,1fr))}.strip .wrap{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.strip .who{grid-column:1/-1}}
@media(max-width:600px){.flow{grid-template-columns:minmax(0,1fr)}.strip .wrap{grid-template-columns:minmax(0,1fr)}.time{font-size:24px}.day{grid-template-columns:4em minmax(0,1fr)}.axis{grid-template-columns:4em minmax(0,1fr)}.lbl{font-size:17px}}
.langbtn{font:inherit;font-size:14px;font-weight:700;min-height:40px;padding:0 16px;border-radius:999px;border:1px solid var(--gold);background:transparent;color:var(--gold);cursor:pointer}
.langbtn:hover{background:var(--gold);color:#0e2240}
.langbtn:focus-visible{outline:3px solid #fff;outline-offset:2px}
.links{align-items:center}
.hub{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px}
.hcard{display:flex;flex-direction:column;gap:6px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px;text-decoration:none;color:inherit}
.hcard strong{font-size:19px;line-height:1.25}
.hcard span{color:var(--muted);font-size:15px}
.hcard .hk{font-size:13px;color:var(--gold);font-weight:500}
.hcard .next{color:var(--ink);font-weight:500;margin-top:auto;white-space:nowrap}
.hcard ul{margin:4px 0 0;padding-inline-start:18px;color:var(--muted);font-size:15px}
.hcard.prime{background:var(--navy);border-color:var(--navy);color:#fff}
.hcard.prime span{color:#c7d3e6}
.hcard.prime .hk{color:var(--gold)}
a.hcard:hover{transform:translateY(-2px);transition:transform .15s}
a.hcard:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.hcard.wide{grid-column:span 2}
.chip{direction:ltr;unicode-bidi:isolate}


.talk{display:grid;grid-template-columns:minmax(0,320px) minmax(0,1fr);gap:28px;align-items:start}
.pt.big{max-width:180px;margin:0 0 12px}
.chat{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:16px;display:flex;flex-direction:column;gap:12px}
.chatlog{height:380px;overflow-y:auto;display:flex;flex-direction:column;gap:10px;padding:4px}
.msg{max-width:85%;padding:10px 14px;border-radius:14px;white-space:pre-wrap;line-height:1.6}
.msg.me{align-self:flex-start;background:var(--navy);color:#fff;border-end-start-radius:4px}
.msg.him{align-self:flex-end;background:var(--bg);border:1px solid var(--line);border-end-end-radius:4px}
.chat-empty{color:var(--muted);margin:auto;text-align:center}
.quick{display:flex;flex-wrap:wrap;gap:8px}
.qbtn{font:inherit;font-size:14px;min-height:40px;padding:0 14px;border-radius:999px;border:1px solid var(--gold);background:transparent;color:var(--ink);cursor:pointer}
.qbtn:hover{background:color-mix(in srgb,var(--gold) 18%,transparent)}
.chatform{display:flex;gap:8px}
.chatform input{flex:1;font:inherit;font-size:16px;min-height:46px;padding:0 14px;border-radius:12px;border:1px solid var(--line);background:var(--bg);color:var(--ink)}
.chatform input:focus-visible,.qbtn:focus-visible,.send:focus-visible,.clear:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.send{font:inherit;font-weight:700;min-height:46px;padding:0 20px;border-radius:12px;border:0;background:var(--gold);color:#0e2240;cursor:pointer}
.send:disabled{opacity:.5;cursor:wait}
.chatbar{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px}
.chatbar .note{margin:0}
.clear{font:inherit;font-size:13px;background:none;border:0;color:var(--muted);text-decoration:underline;cursor:pointer;min-height:36px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
@media(max-width:800px){.talk{grid-template-columns:minmax(0,1fr)}.chatlog{height:320px}}
.pt-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:8px 24px}
.po-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin:8px 0 20px}
.po-k{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px 16px}
.po-k b{display:block;font-size:clamp(26px,3vw,34px);line-height:1.1;font-variant-numeric:tabular-nums}
.po-k span{color:var(--muted);font-size:14px}
.po-k.warn b{color:#d9480f}
.po-tabs{display:flex;flex-wrap:wrap;gap:8px;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:16px}
.po-tab{font:inherit;font-size:15px;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid var(--line);background:var(--bg);color:var(--ink);cursor:pointer}
.po-tab[aria-selected=true]{background:var(--navy);border-color:var(--navy);color:#fff}
.po-tab:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.po-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,380px),1fr));gap:14px}
.po-card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:8px}
.po-card h4{margin:0;font-size:17px}
.po-row{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px}
.po-meta{color:var(--muted);font-size:14px}
.po-pill{border-radius:999px;padding:2px 10px;font-size:13px;border:1px solid var(--line);white-space:nowrap}
.po-pill.hot{color:#d9480f;border-color:#d9480f}.po-pill.warm{color:#b7791f;border-color:#b7791f}.po-pill.ok{color:#12805c;border-color:#12805c}
.po-block{white-space:pre-wrap;font-size:15px;margin:0}
.po-card details summary{cursor:pointer;color:var(--muted);font-size:14px}
.po-select,.po-form select,.po-form input{font:inherit;font-size:16px;min-height:44px;padding:0 10px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--ink)}
.po-btn{font:inherit;font-size:14px;min-height:40px;padding:0 14px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--ink);cursor:pointer}
.po-btn.go{background:var(--gold);border-color:var(--gold);color:#0e2240;font-weight:700}
.po-bar{margin-bottom:12px}
.po-table{width:100%;border-collapse:collapse;font-size:15px}
.po-table th,.po-table td{padding:10px 8px;border-bottom:1px solid var(--line);text-align:start}
.po-table th{color:var(--muted);font-weight:500;font-size:13px}
.po-table td.num{font-variant-numeric:tabular-nums;white-space:nowrap}
.good{color:#12805c;font-weight:700}.bad{color:#d9480f;font-weight:700}
.po-form{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;align-items:end;margin-bottom:16px}
.po-form label{display:flex;flex-direction:column;gap:4px;font-size:13px;color:var(--muted)}
.po-err{color:#d9480f}
.po-sec h5{margin:12px 0 4px;font-size:14px;color:var(--muted);font-weight:500}
</style>
</head>
<body>
<nav class="nav" aria-label="nav">
  <div class="wrap">
    <div class="brand">IntegraBuild <b>·</b> <span data-t="brand">المقر الرقمي</span></div>
    <div class="links"><a href="#portal" data-t="n_portal">البورتال</a><a href="#talk" data-t="n_talk">كلّم المدير</a><a href="#hub" data-t="n_hub">أدواتي</a><a href="#office" data-t="n_office">المكتب</a><a href="#teams" data-t="n_teams">الأقسام</a><a href="#hours" data-t="n_hours">الدوام</a><a href="#how" data-t="n_how">طريقة الشغل</a>
      <button class="langbtn" id="langbtn" type="button" aria-label="Switch language">English</button></div>
  </div>
</nav>

<header class="hero band" id="office">
  <div class="wrap">
    <div class="hrow">
      <div>
        <h1 data-t="h1">مقر فريق المبيعات والتسويق</h1>
        <p class="sub" data-t="sub">ست موظفين ذكاء اصطناعي، ومكتب لكل قسم، ويوسف أبو عيد مديرهم. اضغط على أي مكتب لتشوف شو بيشتغل صاحبه.</p>
      </div>
      <div class="clock">
        <span class="time" id="clock">--:--</span>
        <span class="pill"><span class="dot" id="sdot"></span><span id="stext">…</span></span>
      </div>
    </div>
    <div class="scene scroll-scene"><svg id="floor" role="img"></svg></div>
  </div>
</header>

<section class="strip band" aria-live="polite">
  <div class="wrap">
    <div class="who"><div class="av" id="pav">س</div><div><h2 id="pname">…</h2><p id="prole">…</p></div></div>
    <div><p class="k" data-t="k_now">شو بيعمل هلأ</p><p class="v now"><span class="dot" id="pdot"></span><span id="pnow">…</span></p></div>
    <div><p class="k" data-t="k_next">التسليم الجاي</p><p class="v" id="pnext">…</p></div>
    <div class="tabs" role="group">
      <button class="tab" id="t-mgr" data-id="mgr" aria-pressed="false" data-t="tab_mgr">المدير التنفيذي</button>
      <button class="tab" id="t-sales" data-id="sales" aria-pressed="true" data-t="tab_sales">المبيعات</button>
      <button class="tab" id="t-mkt" data-id="mkt" aria-pressed="false" data-t="tab_mkt">التسويق</button>
      <button class="tab" id="t-fin" data-id="fin" aria-pressed="false" data-t="tab_fin">المالية</button>
      <button class="tab" id="t-it" data-id="it" aria-pressed="false" data-t="tab_it">التقنية</button>
      <button class="tab" id="t-hr" data-id="hr" aria-pressed="false" data-t="tab_hr">الموارد البشرية</button>
    </div>
    <p class="note" data-t="note">المكتب رسم توضيحي: الحالة بتتغيّر حسب جدول الدوام بتوقيت الرياض. الشغل الفعلي بيتسلّم بلوحة الفريق وعلى جوالك الساعة 4:55 العصر.</p>
  </div>
</section>


<section class="band" id="portal">
  <div class="wrap">
    <div class="pt-head">
      <div>
        <h3 data-t="po_h">بورتال الفريق</h3>
        <p class="lead" data-t="po_p">كل شغل الفريق هون: التقارير، والفرص، والمحتوى، والمؤشرات، والتكاليف، والاجتماعات. بتعتمد وبتحرّك من نفس المكان.</p>
      </div>
      <p class="note" id="po-state">…</p>
    </div>
    <div class="po-kpis" id="po-kpis"></div>
    <div class="po-tabs" role="tablist" id="po-tabs">
      <button role="tab" class="po-tab" data-p="rep" data-t="pt_rep">آخر تقرير</button>
      <button role="tab" class="po-tab" data-p="leads" data-t="pt_leads">الفرص</button>
      <button role="tab" class="po-tab" data-p="content" data-t="pt_content">المحتوى</button>
      <button role="tab" class="po-tab" data-p="kpi" data-t="pt_kpi">المؤشرات</button>
      <button role="tab" class="po-tab" data-p="costs" data-t="pt_costs">التكاليف</button>
      <button role="tab" class="po-tab" data-p="meet" data-t="pt_meet">الاجتماعات</button>
    </div>
    <p class="po-err" id="po-err" hidden></p>
    <div class="po-panel" data-panel="rep" id="pp-rep"></div>
    <div class="po-panel" data-panel="leads" hidden>
      <div class="po-bar"><select id="po-rating" aria-label="rating"></select></div>
      <div class="po-list" id="pp-leads"></div>
    </div>
    <div class="po-panel" data-panel="content" hidden><div class="po-list" id="pp-content"></div></div>
    <div class="po-panel" data-panel="kpi" hidden><div class="scroll"><table class="po-table" id="pp-kpi"></table></div><p class="note" data-t="kpi_note">آخر 7 أيام بتوقيت الرياض. الأهداف مبدئية وإنت بتعدّلها.</p></div>
    <div class="po-panel" data-panel="costs" hidden>
      <form class="po-form" id="po-cost">
        <label><span data-t="c_date">التاريخ</span><input type="date" id="pc-date" required></label>
        <label><span data-t="c_item">البند</span><input type="text" id="pc-item" required></label>
        <label><span data-t="c_cat">الفئة</span><select id="pc-cat"></select></label>
        <label><span data-t="c_amt">المبلغ (ر.س)</span><input type="number" id="pc-amt" min="0" step="0.01" inputmode="decimal" required></label>
        <button class="send" type="submit" data-t="c_add">أضف التكلفة</button>
      </form>
      <div class="po-list" id="pp-costs"></div>
    </div>
    <div class="po-panel" data-panel="meet" hidden id="pp-meet"></div>
  </div>
</section>

<section class="band" id="talk" style="background:var(--panel)">
  <div class="wrap talk">
    <div class="talk-side">
      <div class="pt big" id="mgrpt"></div>
      <h3 data-t="talk_h">مكتب المدير: اسأله عن الأبديت</h3>
