function nowText(id, t) {
  const p = tr().team[id];
  if (t.day <= 4 && t.h === 17 && t.m < 30) return tr().inStandup;
  if (!onDuty(t)) return t.day >= 5 ? tr().weekend : tr().offduty;
  if (t.day === 0 && t.h === 9) return tr().inMeeting;
  if ((id === 'mgr' || id === 'fin') && t.day === 4 && t.h >= 15) return p.thu;
  if (id === 'it' && t.day === 3 && t.h >= 15) return p.thu;
  if (id === 'hr') return p.work[(t.h + Math.floor(t.m / 20)) % p.work.length];
  if ((id === 'sales' || id === 'mkt') && t.h === 16) return tr().prep;
  return p.work[(t.h + Math.floor(t.m / 20)) % p.work.length];
}
